# Copy to .env and adjust. docker compose reads .env automatically.

# Port on the host: audium is then reachable at http://<server-ip>:8091
AUDIUM_HOST_PORT=8091

# Your music folder on the host (mounted read-only)
AUDIUM_MUSIC_PATH=/srv/music

TZ=Europe/Berlin

# Optional: create the admin account on first start instead of using the setup token.
# Remove both lines again after the first start.
# AUDIUM_ADMIN_USER=admin
# AUDIUM_ADMIN_PASSWORD=choose-a-long-password
